#!/data/data/com.termux/files/usr/bin/bash
# ================================================================
# NEXUS X — SERVERLESS NEON POSTGRES MIGRATION ARCHITECTURE
# ================================================================

echo "🚀 Memulai restrukturisasi Nexus X ke Neon Serverless Postgres..."

# 1. VALIDASI LINGKUNGAN DATABASE
if [ -z "$POSTGRES_URL" ]; then
    echo "⚠️  Error: Environment variable POSTGRES_URL tidak ditemukan!"
    echo "Silakan ekspor dulu di Termux: export POSTGRES_URL='isi_url_neon_kamu'"
    exit 1
fi

# 2. UPDATE PACKAGE.JSON & INSTALL DEPENDENCIES
echo "📦 Mengonfigurasi dependensi project..."
cat << 'JSONEOF' > package.json
{
  "name": "nexus-x-cloud",
  "version": "8.8.0",
  "description": "Premium Script Management with Neon Serverless Postgres",
  "main": "api/server.js",
  "type": "module",
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "dotenv": "^16.4.5"
  }
}
JSONEOF

npm install --no-audit --no-fund

# 3. KREASI FILE KONFIGURASI .ENV
cat << ENVEOF > .env
POSTGRES_URL="${POSTGRES_URL}"
ENVEOF

# 4. MEMBUAT PROSES INITIALISASI TABEL DB (MIGRATION SYSTEM)
echo "🗄️  Menginisialisasi skema tabel database di Neon..."
node -e "
import { neon } from '@neondatabase/serverless';
import 'dotenv/config';

async function initDB() {
  const sql = neon(process.env.POSTGRES_URL);
  try {
    // Tabel Akun Pengguna
    await sql\`CREATE TABLE IF NOT EXISTS accounts (
      email VARCHAR(255) PRIMARY KEY,
      password VARCHAR(255) NOT NULL,
      code VARCHAR(50),
      created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    )\`;

    // Tabel Berkas LUA/Scripts
    await sql\`CREATE TABLE IF NOT EXISTS scripts (
      id VARCHAR(255) PRIMARY KEY,
      name VARCHAR(255) NOT NULL,
      content TEXT NOT NULL,
      updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    )\`;

    // Tabel Lisensi / Key System
    await sql\`CREATE TABLE IF NOT EXISTS keys (
      key VARCHAR(255) PRIMARY KEY,
      script_id VARCHAR(255) REFERENCES scripts(id) ON DELETE CASCADE,
      target_script_name VARCHAR(255),
      expiry TIMESTAMP NOT NULL,
      max_devices INT DEFAULT 1,
      registered_devices TEXT[] DEFAULT '{}'::TEXT[]
    )\`;

    console.log('✅ Skema tabel database berhasil dibangun.');
  } catch (err) {
    console.error('❌ Gagal menginisialisasi database:', err);
    process.exit(1);
  }
}
initDB();
"

