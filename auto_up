#!/data/data/com.termux/files/usr/bin/bash
cd "$(dirname "$0")"

VERCEL_URL="https://riskia.vercel.app"

echo "📥 Menyedot sinkronisasi data dari cloud..."
curl -s "$VERCEL_URL/api/server?type=sync" > database_temp.json

if grep -q "accounts" database_temp.json; then
  mv database_temp.json database.json
  echo "  [✓] Local database updated from live server."
else
  echo "  [⚠️] Data cloud kosong/gagal fetch. Mempertahankan database lokal."
  rm -f database_temp.json
fi

# Cek branch aktif biar jalurnya tepat (main atau master)
BRANCH_NAME=$(git branch --show-current)
if [ -z "$BRANCH_NAME" ]; then
  BRANCH_NAME="main"
  git branch -M main
fi

# Daftarkan perubahan (HANYA menambahkan file database & backend baru tanpa menghapus file lama lu)
git add api/server.js database.json auto_up index.html 2>/dev/null

echo "📤 Melakukan push pembaruan aman ke branch: $BRANCH_NAME..."
git commit -m "Nexus X v9.5 — Immortal Salt & Structure Fixed" --allow-empty
git push origin $BRANCH_NAME

echo "🚀 SUCCESS! File backend terpasang rapi di https://github.com/kiriskae-create/Riskia"
